<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <!-- In-memory SQLite: a real relational engine, not a double. Keys, constraints and
         transactions with rollback are exactly what an in-memory provider does not exercise. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- A real in-memory host for the endpoints: authentication, policies and routes as an
         application wires them, not the delegates called by hand. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\kdyf.Authorization.Administration\kdyf.Authorization.Administration.csproj" />
    <!-- Only so DependencyDirectionTests can load it: the Entra authorization package must not
         reference administration either. -->
    <ProjectReference Include="..\..\src\kdyf.Authorization.EntraId\kdyf.Authorization.EntraId.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

</Project>
