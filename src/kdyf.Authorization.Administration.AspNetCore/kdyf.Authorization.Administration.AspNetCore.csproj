<Project Sdk="Microsoft.NET.Sdk">

  <!-- The composition of ACCESS ADMINISTRATION for an ASP.NET Core host, on top of AddKdyfAuthorization
       (kdyf.Authorization.AspNetCore) and from the same KdyfAuthorization section: the administration services, the group and
       the directory through Graph, the audit log (where simulations are recorded too) and the policies that
       guard the administration and the tokens, under their fixed names (AccessPolicyNames).

       Only a host that administers access references this one; a host that only authorizes stops at
       kdyf.Authorization.AspNetCore. Administration depends on authorization, never the other way round.
       No endpoints: the host's module exposes them. -->
  <PropertyGroup>
    <Description>Composition of the kdyf.Authorization administration for an ASP.NET Core host: AddKdyfAuthorizationAdministration, its database context and its policies.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\kdyf.Authorization.AspNetCore\kdyf.Authorization.AspNetCore.csproj" />
    <ProjectReference Include="..\kdyf.Authorization.Administration\kdyf.Authorization.Administration.csproj" />
    <ProjectReference Include="..\kdyf.Authorization.Administration.EntraId\kdyf.Authorization.Administration.EntraId.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="kdyf.Authorization.Administration.AspNetCore.Test" />
  </ItemGroup>

</Project>
