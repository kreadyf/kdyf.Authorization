<Project Sdk="Microsoft.NET.Sdk">

  <!-- OPTIONAL endpoints of the session: GET auth/me and GET auth/policies, as minimal APIs that exist only when the
       host calls MapKdyfAuthorizationSession(). Also what every endpoint package of the library shares: the response
       writer a host replaces to keep its own envelope (IKdyfAuthorizationResultWriter), and the filter that never lets
       a database or directory failure reach the client with its own text.

       Minimal APIs, never controllers: MVC discovers controllers in every referenced assembly, so a host calling
       AddControllers() would get routes it never asked for. -->
  <PropertyGroup>
    <Description>Optional minimal API endpoints for kdyf.Authorization: GET auth/me and GET auth/policies, with a pluggable response writer.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\kdyf.Authorization.AspNetCore\kdyf.Authorization.AspNetCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="kdyf.Authorization.Administration.Endpoints" />
    <InternalsVisibleTo Include="kdyf.Authorization.Endpoints.Test" />
  </ItemGroup>

</Project>
