<Project Sdk="Microsoft.NET.Sdk">

  <!-- The composition of AUTHORIZATION for an ASP.NET Core host (AddKdyfAuthorization), configured from ONE section.
       It wires authentication (the identity provider's scheme + personal access tokens), the fallback policy,
       permission-based authorization and user simulation - so a host writes a few calls instead of sixty lines.

       Knows no database and no identity provider: the host plugs them in with the providers' own calls
       (UseEntityFrameworkStore, UseEntraId), from the packages it chooses to reference.

       No administration and no endpoints. Administration is composed on top of this by
       kdyf.Authorization.Administration.AspNetCore, which only a host that administers access references. -->
  <PropertyGroup>
    <Description>Composition of kdyf.Authorization for an ASP.NET Core host from one configuration section: AddKdyfAuthorization, UseKdyfAuthorization and user simulation, validated at startup.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\kdyf.Authorization\kdyf.Authorization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="kdyf.Authorization.AspNetCore.Test" />
    <!-- Composes administration on top of this one: shares the single-permission rule. -->
    <InternalsVisibleTo Include="kdyf.Authorization.Administration.AspNetCore" />
  </ItemGroup>

</Project>
