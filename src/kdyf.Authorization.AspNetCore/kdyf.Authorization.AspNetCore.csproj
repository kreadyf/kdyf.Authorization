<Project Sdk="Microsoft.NET.Sdk">

  <!-- The composition of AUTHORIZATION for an ASP.NET Core host (AddKdyfAuthorization), configured from ONE section.
       It wires authentication (the identity provider's scheme + personal access tokens), the fallback policy,
       permission-based authorization and user simulation - so a host writes a few calls instead of sixty lines.

       Knows no database and no identity provider: the host plugs them in with the providers' own calls
       (UseEntityFrameworkStore, UseEntraId), from the packages it chooses to reference.

       Endpoints/: the OPTIONAL endpoints of the session, GET auth/me and GET auth/policies, as minimal APIs that exist
       only when the host calls MapKdyfAuthorizationSession(); and what every endpoint of the library shares: the
       response writer a host replaces to keep its own envelope (IKdyfAuthorizationResultWriter), and the filter that
       never lets a database or directory failure reach the client with its own text. Minimal APIs, never controllers:
       MVC discovers controllers in every referenced assembly, so a host calling AddControllers() would get routes it
       never asked for.

       No administration. It is composed on top of this by kdyf.Authorization.Administration, which only a host that
       administers access references. -->
  <PropertyGroup>
    <Description>Composition of kdyf.Authorization for an ASP.NET Core host from one configuration section: AddKdyfAuthorization, UseKdyfAuthorization, user simulation and the optional session endpoints (GET auth/me, GET auth/policies), validated at startup.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\kdyf.Authorization\kdyf.Authorization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="kdyf.Authorization.AspNetCore.Test" />
    <InternalsVisibleTo Include="kdyf.Authorization.Endpoints.Test" />
    <!-- Composes administration on top of this one: shares the single-permission rule, the failure filter and the
         response writer. -->
    <InternalsVisibleTo Include="kdyf.Authorization.Administration" />
  </ItemGroup>

</Project>
