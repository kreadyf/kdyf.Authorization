<Project>

  <!-- Common to every project of the solution. What is specific to one project goes in its .csproj. -->
  <PropertyGroup>
    <!-- .NET 8 (LTS) and .NET 10: one package serves hosts on either. The versions of the framework-tied packages
         follow the target (Directory.Packages.props). -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Every package of the solution ships with the same version: AspNetCore and Administration share
       internals, so a mismatched pair could break without any public API changing. pack-local.ps1 sets VersionSuffix;
       the release workflow sets Version from the tag (v1.0.0-preview.2 -> 1.0.0-preview.2). -->
  <PropertyGroup>
    <VersionPrefix>1.2.1</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">dev</VersionSuffix>
    <Authors>kreadyf</Authors>
    <Company>kreadyf</Company>
    <Copyright>Copyright © kreadyf</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kreadyf/kdyf.Authorization</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/kreadyf/kdyf.Authorization</PackageProjectUrl>
    <PackageTags>authorization;permissions;entra-id;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/kreadyf/kdyf.Authorization/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Deterministic paths in the published symbols: on Azure Pipelines and on GitHub Actions. -->
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Only the libraries under src/ are packages. Tests stay IsPackable=false. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- The tests run each target on its own EF Core line (10 on net10), while the libraries ask for 8 at least: so the net10
       run proves the packages built against EF Core 8 on EF Core 10. -->
  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)test$([System.IO.Path]::DirectorySeparatorChar)'))">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="$(AspNetCoreVersion)" />
  </ItemGroup>

  <!-- Each package's page on nuget.org shows the project's own PACKAGE.md (what that package is, how to install it, a
       short sample, its siblings), packed as README.md; the root README.md is the full guide, on GitHub. A project
       without a PACKAGE.md packs the root README. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeSource Condition="Exists('$(MSBuildProjectDirectory)\PACKAGE.md')">$(MSBuildProjectDirectory)\PACKAGE.md</PackageReadmeSource>
    <PackageReadmeSource Condition="'$(PackageReadmeSource)' == ''">$(MSBuildThisFileDirectory)README.md</PackageReadmeSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(PackageReadmeSource)" Pack="true" PackagePath="\README.md" Visible="false" />
  </ItemGroup>

  <!-- Package validation: the net8.0 and net10.0 assets of each package must offer the same API, and the API of the last
       published version must still be there (PackageValidationBaselineVersion), so that a 1.x that breaks it fails the
       pack. Raise the baseline after each release. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.2.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!-- The packages depend on each other with the EXACT version ([1.0.0]), never "1.0.0 or later": they ship together and
       AspNetCore and Administration share internals, so a newer sibling next to an older one could break at run time
       without any public API changing. NuGet then keeps the whole family on one version. -->
  <Target Name="KdyfExactSiblingVersions" AfterTargets="_GetProjectReferenceVersions" Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(_ProjectReferencesWithVersions.ProjectVersion)]" />
    </ItemGroup>
  </Target>

</Project>
